# Configuración de Odín.
# Copia este archivo como ".env" (en la misma carpeta) y rellena tus datos.
# El archivo .env no se sube a GitHub. Nunca pongas claves en este ejemplo.

# --- Voz (ElevenLabs) --------------------------------------------------------
# Tu clave de API (empieza por sk_), no el ID de una voz.
ELEVENLABS_API_KEY=

# --- Calendario de iCloud ------------------------------------------------------
# Se usa en Windows (y en el Mac si pones CALENDAR_BACKEND=icloud).
# La contraseña es una "contraseña de app": appleid.apple.com → Inicio de sesión
# y seguridad → Contraseñas de app. NO uses la contraseña de tu Apple ID.
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# Calendario donde se crean los eventos si no dices otro (opcional).
ICLOUD_DEFAULT_CALENDAR=Casa
# CALENDAR_BACKEND=icloud

# --- Home Assistant -------------------------------------------------------------
# Dirección de Home Assistant y un "token de acceso de larga duración"
# (Home Assistant → tu perfil → Seguridad → Tokens de acceso de larga duración).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Cerebro ------------------------------------------------------------------
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=high
